theme = CGA

font-family = Lilex Nerd Font
font-style = Regular
font-size = 12
font-feature = calt
font-feature = liga
font-feature = clig

window-width = 120
window-height = 34

window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
confirm-close-surface = false
resize-overlay = never

background-opacity = 0.95
unfocused-split-opacity = 0.95

cursor-style = block
cursor-style-blink = false

shell-integration-features = no-cursor,ssh-env,sudo

scrollback-limit = 10000

keybind = clear

keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+comma=reload_config

keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab

keybind = ctrl+shift+z=toggle_split_zoom

keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9

keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard:plain
keybind = control+shift+c=copy_to_clipboard:plain
keybind = control+shift+v=paste_from_clipboard
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u

keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down

keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+right=goto_split:right

keybind = ctrl+left=csi:1;5D
keybind = ctrl+right=csi:1;5C
keybind = alt+backspace=text:\x08
keybind = alt+delete=csi:3;5~

mouse-scroll-multiplier = 0.95
gtk-single-instance = true

