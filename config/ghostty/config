theme = CGA

font-family = Lilex Nerd Font
font-style = Regular
font-size = 12
font-feature = calt
font-feature = liga
font-feature = clig

window-width = 120
window-height = 34

window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
confirm-close-surface = false
resize-overlay = never

background-opacity = 0.95
unfocused-split-opacity = 0.95

cursor-style = block
cursor-style-blink = false

shell-integration-features = no-cursor,ssh-env,sudo

scrollback-limit = 100000

keybind = ctrl+w=close_surface

keybind = ctrl+enter=toggle_split_zoom

keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+right=goto_split:right

mouse-scroll-multiplier = 0.95
gtk-single-instance = true

